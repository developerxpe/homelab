# --- gizli / yerel ---
.secret
.env
**/.DS_Store

# --- yerel veri dizinleri ---
# Icerikleri repoya GIRMEZ (secret / runtime). Sadece klasor adlari .gitkeep ile kalir.
vw-data
cloudflared/*
!cloudflared/config.yml
beszel_data/*
!beszel_data/.gitkeep
beszel_socket/*
!beszel_socket/.gitkeep
beszel_agent_data/*
!beszel_agent_data/.gitkeep
coolify/*
!coolify/.gitkeep

# --- runtime / uretilen dosyalar (repoda tutulmaz) ---
npm/letsencrypt/*
!npm/letsencrypt/.gitkeep
npm/data/logs/
npm/data/database.sqlite
npm/data/keys.json
__pycache__/

# --- yerel konteyner konfigurasyonu (diskte kalir, takip edilmez) ---
pma/*
!pma/.gitkeep
foto/*
!foto/Dockerfile

# DevXPE homelab stack - ortam degiskenleri ORNEGI (yapiyi korur, deger tasimaz)
#
# Bu dosya, hangi servisin hangi ortam degiskenini kullandigini (mimariyi)
# belgelemek icin burada. Gercek degerler ve GIZLI anahtarlar/tokenlar
# `.env` dosyasinda tutulur; `.gitignore` sayesinde depoya GIRMEZ.
#
# Repoda tutulmayan gizli/yerel dosyalar (.gitignore ile korunuyor):
#   - .env                     (bu dosyanin doldurulmus hali)
#   - cloudflared/             (cloudflare tunnel cert.pem + <uuid>.json tokeni)
#   - npm/letsencrypt/         (TLS ozel anahtarlari: privkey*.pem, private_key.json)
#   - pma/                     (phpMyAdmin /config: ayarlar ve loglar)
#   - foto/                    (yalniz Dockerfile takip edilir; gerisi yerel)
#
# Kullanim:
#   cp .env.example .env
#   ...ve degerleri doldur.

# --- Vaultwarden ---
# Yayin adresi (gizli degil)
DOMAIN=
# Vaultwarden admin paneli token'i  [GIZLI - tasinmadi]
ADMIN_TOKEN=

# --- Vaultwarden SSO (cookie vendor) ---
SSO_COOKIE_VENDOR_ENABLED=
SSO_COOKIE_VENDOR_IDP_LOGIN_URL=
SSO_COOKIE_VENDOR_COOKIE_NAME=
SSO_COOKIE_VENDOR_COOKIE_DOMAIN=

# --- Beszel (sunucu izleme) agent ---
# Agent kayit anahtari  [GIZLI - tasinmadi]
BESZEL_AGENT_KEY=
# Agent token'i  [GIZLI - tasinmadi]
BESZEL_AGENT_TOKEN=

# --- MySQL (foto uygulamasinin veritabani) ---
# Root sifresi  [GIZLI - tasinmadi]
MYSQL_ROOT_PASSWORD=
# Uygulama kullanicisi ve sifresi  [GIZLI - tasinmadi]
MYSQL_USER=
MYSQL_PASSWORD=
# Veritabani adi  [gizli degil]  (foto uygulamasi icin: vadidave_fotser)
MYSQL_DATABASE=
